# RinglyPro Lite — environment (ISOLATED from full RinglyPro).
# Copy to .env for local dev; set these on the SEPARATE Render service for prod.

# --- Core ---
LITE_PORT=10001
LITE_WEBHOOK_BASE_URL=https://ringlypro-lite.onrender.com   # public https host (drives wss:// + webhooks)

# --- Database (MUST be a separate DB from full RinglyPro) ---
LITE_DATABASE_URL=postgres://user:pass@host:5432/ringlypro_lite

# --- Auth ---
LITE_JWT_SECRET=change-me-long-random   # falls back to JWT_SECRET if unset

# --- Voice brain (Claude Haiku) ---
LITE_ANTHROPIC_API_KEY=sk-ant-...        # falls back to ANTHROPIC_API_KEY
LITE_VOICE_MODEL=claude-haiku-4-5-20251001
LITE_MAX_TURNS=10
LITE_POLLY_VOICE_EN=Joanna-Neural
LITE_POLLY_VOICE_ES=Lupe-Neural

# --- Telephony (SEPARATE Twilio subaccount) ---
LITE_TELEPHONY_PROVIDER=twilio
LITE_TWILIO_ACCOUNT_SID=ACxxxxxxxx        # Lite subaccount
LITE_TWILIO_AUTH_TOKEN=xxxxxxxx
LITE_CO_NUMBERS_ENABLED=0                 # set 1 only after the Colombia regulatory bundle is approved

# --- Billing (Stripe) ---
LITE_STRIPE_SECRET_KEY=sk_live_...
LITE_STRIPE_WEBHOOK_SECRET=whsec_...
LITE_TRIAL_DAYS=7
# Flat plan price (config, not hardcoded). Use a Price ID OR inline cents.
LITE_STRIPE_PRICE_US=price_...
LITE_STRIPE_PRICE_CO=price_...
LITE_PRICE_US_CENTS=4900
LITE_PRICE_CO_CENTS=9900

# --- Internal ---
LITE_ADMIN_KEY=change-me                  # gates /internal/economics
LITE_COGS_TARGET_PER_MIN=0.06

# --- COGS rate overrides (defaults reflect verified 2026 pricing; see docs) ---
# LITE_COGS_VOICE_MIN_US=0.0785
# LITE_COGS_VOICE_MIN_CO=0.1645
# LITE_COGS_DID_MONTHLY_US=1.0
# LITE_COGS_DID_MONTHLY_CO=14.0
