{
  "name": "jobup-video-pipeline",
  "version": "1.0.0",
  "private": true,
  "description": "3D animated promo video pipeline — locked character, short shots, burned captions, one voiceover",
  "main": "src/pipeline/runner.js",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "test": "node tests/pipeline.test.js && node tests/providers.test.js",
    "demo": "node demo/render-demo.js",
    "check:ffmpeg": "node -e \"const{FFMPEG,FFPROBE}=require('./src/ffmpeg');console.log(FFMPEG);console.log(FFPROBE)\" && node -e \"require('child_process').execFileSync(require('./src/ffmpeg').FFMPEG,['-version'],{stdio:'inherit'})\""
  },
  "dependencies": {
    "ffmpeg-static": "^5.3.0"
  }
}
